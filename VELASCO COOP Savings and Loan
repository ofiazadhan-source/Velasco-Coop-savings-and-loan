@charset "utf-8";

* { margin: 0px; padding: 0px; box-sizing: border-box; font-family: "Segoe UI", Arial, sans-serif; }

body { background: rgb(245, 245, 245); color: rgb(51, 51, 51); }

.container { max-width: 1000px; margin: 20px auto; padding: 20px; }

.card { background: rgb(255, 255, 255); border-radius: 12px; padding: 20px; margin-bottom: 20px; box-shadow: rgba(0, 0, 0, 0.1) 0px 2px 8px; }

h1 { text-align: center; color: rgb(255, 107, 53); margin-bottom: 20px; }

h2 { color: rgb(255, 107, 53); margin-bottom: 15px; }

h3 { color: rgb(51, 51, 51); margin: 15px 0px 10px; }

input, select, button { width: 100%; padding: 12px; margin: 8px 0px; border: 1px solid rgb(221, 221, 221); border-radius: 8px; font-size: 16px; }

button { background: rgb(255, 107, 53); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; font-weight: bold; }

button:hover { background: rgb(229, 90, 43); }

.btn-secondary { background: rgb(102, 102, 102); }

.btn-danger { background: rgb(220, 53, 69); }

.btn-small { width: auto; padding: 5px 10px; font-size: 14px; }

table { width: 100%; border-collapse: collapse; margin-top: 15px; }

th, td { padding: 12px; text-align: left; border-bottom: 1px solid rgb(221, 221, 221); }

th { background: rgb(255, 107, 53); color: white; }

.badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; }

.badge-admin { background: rgb(255, 107, 53); color: white; }

.badge-member { background: rgb(40, 167, 69); color: white; }

.login-box { max-width: 400px; margin: 100px auto; }

.hidden { display: none; }

.dark-mode { background: rgb(26, 26, 26); color: rgb(255, 255, 255); }

.dark-mode.card { background: rgb(45, 45, 45); color: rgb(255, 255, 255); }

.dark-mode input, .dark-mode select { background: rgb(61, 61, 61); color: rgb(255, 255, 255); border-color: rgb(85, 85, 85); }

.modal { display: none; position: fixed; top: 0px; left: 0px; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 1000; overflow-y: auto; }

.modal-content { background: white; margin: 5% auto; padding: 20px; width: 90%; max-width: 500px; border-radius: 12px; }

.dark-mode.modal-content { background: rgb(45, 45, 45); }

hr { border-width: 1px medium medium; border-style: solid none none; border-color: rgb(221, 221, 221) currentcolor currentcolor; border-image: initial; margin: 20px 0px; }

.history-item { padding: 8px; border-bottom: 1px solid rgb(238, 238, 238); font-size: 14px; }

.history-deposit { color: rgb(40, 167, 69); }

.history-withdraw { color: rgb(220, 53, 69); }

.history-loan { color: rgb(23, 162, 184); }

@media print {
  body * { visibility: hidden; }
  #receiptPrint, #receiptPrint * { visibility: visible; }
  #receiptPrint { position: absolute; left: 0px; top: 0px; width: 100%; }
}
